# Supabase project (EU / Frankfurt). Both values are safe to expose in the
# frontend bundle: authorisation is enforced by Row Level Security, not here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base path for the production build. '/<repo-name>/' for GitHub Pages,
# '/' when a custom domain is attached.
VITE_BASE_PATH=/Koreman-CRM-systeem/
